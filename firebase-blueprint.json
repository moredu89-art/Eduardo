{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Publicly scoped Firebase user profile without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication UID"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "User display name"
        },
        "role": {
          "type": "string",
          "enum": ["JEFE_STOCK", "CONTADOR", "RESPONSABLE_DEPOSITO", "AUDITORIA_DIRECCION"],
          "description": "MercoMat ERP role"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["uid", "displayName", "role", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document storing user email under private subcollection.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Trusted admin role assignment marker.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "grantedBy", "createdAt"]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "MercoMat cloud workspace owned by an authenticated user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "projectCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerUid", "name", "projectCode", "createdAt", "updatedAt"]
    },
    "CatalogSnapshot": {
      "title": "CatalogSnapshot",
      "description": "Point-in-time inventory summary backup in Firestore.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "totalProducts": {
          "type": "integer"
        },
        "totalLocations": {
          "type": "integer"
        },
        "totalPhysicalStock": {
          "type": "number"
        },
        "summaryNotes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "workspaceId",
        "title",
        "totalProducts",
        "totalLocations",
        "totalPhysicalStock",
        "summaryNotes",
        "createdAt",
        "updatedAt"
      ]
    },
    "CatalogItem": {
      "title": "CatalogItem",
      "description": "Cloud-synced article from Almacen Maestro.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "brand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "unitOfMeasure": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "totalErpPhysical": {
          "type": "number"
        },
        "totalCommitted": {
          "type": "number"
        },
        "totalAvailable": {
          "type": "number"
        },
        "criticalityLevel": {
          "type": "string",
          "enum": ["ALTA", "MEDIA", "BAJA"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "workspaceId",
        "sku",
        "description",
        "family",
        "brand",
        "unitOfMeasure",
        "totalErpPhysical",
        "totalCommitted",
        "totalAvailable",
        "criticalityLevel",
        "createdAt",
        "updatedAt"
      ]
    },
    "CountRecord": {
      "title": "CountRecord",
      "description": "Cloud-synced physical inventory count record.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "countNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "locationName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "scheduledDate": {
          "type": "string",
          "minLength": 8,
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "enum": [
            "BORRADOR",
            "ASIGNADO",
            "EN_EJECUCION",
            "PENDIENTE_APROBACION",
            "RECHAZADO",
            "APROBADO",
            "PENDIENTE_REGULARIZACION",
            "CERRADO"
          ]
        },
        "itemsCount": {
          "type": "integer"
        },
        "discrepanciesCount": {
          "type": "integer"
        },
        "counterName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "workspaceId",
        "countNumber",
        "locationName",
        "scheduledDate",
        "status",
        "itemsCount",
        "discrepanciesCount",
        "counterName",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Non-PII user profile documents keyed by Firebase Auth UID."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII subcollection (email) readable/writable only by the owner or admin."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Trusted administrator marker documents."
    },
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "MercoMat cloud workspace containers owned by authenticated users."
    },
    "/workspaces/{workspaceId}/catalogSnapshots/{snapshotId}": {
      "schema": { "$ref": "#/entities/CatalogSnapshot" },
      "description": "Inventory summary snapshots inside a workspace."
    },
    "/workspaces/{workspaceId}/catalogItems/{itemId}": {
      "schema": { "$ref": "#/entities/CatalogItem" },
      "description": "Master catalog items synced to Firestore."
    },
    "/workspaces/{workspaceId}/countRecords/{recordId}": {
      "schema": { "$ref": "#/entities/CountRecord" },
      "description": "Physical inventory count records synced to Firestore."
    }
  }
}
